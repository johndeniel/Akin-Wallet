<?xml version="1.0" encoding="utf-8"?><!--
   Akin Wallet backup rules. The vault database is SQLCipher-encrypted with
   a Keystore-wrapped key that never leaves this device, so a restored copy
   could never be opened again — exclude it (and the wrapped key) rather
   than back up data the user could never read. See
   https://developer.android.com/guide/topics/data/autobackup
   for details.
-->
<full-backup-content>
    <exclude domain="database" path="akin_wallet.db" />
    <exclude domain="sharedpref" path="akin_vault_key.xml" />
    <!-- PIN hash/salt + lockout counters: restoring them without the vault
         leaves a PIN-locked empty install. Force clean setup on restore. -->
    <exclude domain="sharedpref" path="akin_app_lock.xml" />
</full-backup-content>
