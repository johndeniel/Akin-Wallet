<?xml version="1.0" encoding="utf-8"?><!--
   Akin Wallet data-extraction rules (API 31+). Same reason as backup_rules:
   the encrypted vault and its Keystore-wrapped key must not roam — a copy
   restored elsewhere could never be decrypted. See
   https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="akin_wallet.db" />
        <exclude domain="sharedpref" path="akin_vault_key.xml" />
        <exclude domain="sharedpref" path="akin_app_lock.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="akin_wallet.db" />
        <exclude domain="sharedpref" path="akin_vault_key.xml" />
        <exclude domain="sharedpref" path="akin_app_lock.xml" />
    </device-transfer>
</data-extraction-rules>
