<?xml version="1.0" encoding="utf-8"?>
<!-- ============================================================
     Akin Wallet — Dashboard (Home), hosted directly by DashboardActivity.
     M3 TopAppBar (wordmark + tagline) with search + settings IconButtons;
     the search icon opens the full-screen M3 SearchView which filters the
     vault; Government ID + Bank Card carousels, Social Account M3 card
     list and the circular quick-add FAB live underneath.
     CoordinatorLayout root hosts the SearchView transition.
     ============================================================ -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_dashboard_root"
    android:fitsSystemWindows="false"
    tools:context=".activity.DashboardActivity">

        <!-- Fixed dashboard content (not scrollable); FAB floats over it, no reserved gap.
             The screen header (wordmark + tagline + bell) lives here in-content;
             the host theme is NoActionBar so there is exactly one header. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp">

        <!-- M3 small top app bar: wordmark + trust tagline via Toolbar
             title/subtitle (same insets as Settings so headers match) with
             trailing M3 tonal IconButtons for search + settings. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/dashboard_toolbar"
                style="@style/Widget.Akin.Toolbar"
                android:layout_width="0dp"
                android:layout_weight="1"
                app:navigationIcon="@null"
                app:subtitle="@string/header_tagline"
                app:subtitleTextAppearance="@style/TextAppearance.Akin.ToolbarSubtitle"
                app:title="@string/app_name" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/dashboard_header_search_button"
                style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="12dp"
                android:contentDescription="@string/cd_search"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                app:backgroundTint="@color/dashboard_well"
                app:icon="@drawable/ic_search_white"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="18dp"
                app:iconTint="@color/text_primary"
                app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Circle"
                app:strokeColor="@color/dashboard_well_border"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/dashboard_header_settings_button"
                style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="12dp"
                android:contentDescription="@string/cd_settings"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                app:backgroundTint="@color/dashboard_well"
                app:icon="@drawable/ic_settings"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="18dp"
                app:iconTint="@color/text_primary"
                app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Circle"
                app:strokeColor="@color/dashboard_well_border"
                app:strokeWidth="1dp" />

        </LinearLayout>

        <!-- Government ID section header (no tab: View All removed) -->
        <LinearLayout
            android:id="@+id/dashboard_header_ids"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/trash_section_ids"
                android:textAppearance="@style/TextAppearance.Akin.SectionTitle" />

        </LinearLayout>

        <!-- Government ID carousel (live: renders IDs created in Government ID) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/dashboard_ids_carousel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:paddingEnd="36dp" />

        <!-- Empty state: M3 filled card with title + supporting text + tonal
             action (whole card also opens the creator, keeping old behavior). -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/dashboard_ids_empty_state"
            style="@style/Widget.Akin.DashboardCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"
            app:rippleColor="?attr/colorControlHighlight">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="16dp"
                android:paddingBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/empty_ids_title"
                    android:textAppearance="@style/TextAppearance.Akin.CardTitle" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="@string/empty_ids_sub"
                    android:textAppearance="@style/TextAppearance.Akin.BodyMuted" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/dashboard_ids_empty_action"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/dialog_id_title"
                    android:textColor="@color/text_primary"
                    app:backgroundTint="@color/dashboard_well"
                    app:icon="@drawable/ic_add"
                    app:iconSize="16dp"
                    app:iconTint="@color/text_primary" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Bank Card section header (no tab: View All removed) -->
        <LinearLayout
            android:id="@+id/dashboard_header_cards"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/trash_section_cards"
                android:textAppearance="@style/TextAppearance.Akin.SectionTitle" />

        </LinearLayout>

        <!-- Bank card carousel (live: renders cards created in Bank Card) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/dashboard_cards_carousel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:paddingEnd="36dp" />

        <!-- Empty state: M3 filled card with title + supporting text + tonal action. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/dashboard_cards_empty_state"
            style="@style/Widget.Akin.DashboardCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"
            app:rippleColor="?attr/colorControlHighlight">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="16dp"
                android:paddingBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/empty_cards_title"
                    android:textAppearance="@style/TextAppearance.Akin.CardTitle" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="@string/empty_cards_sub"
                    android:textAppearance="@style/TextAppearance.Akin.BodyMuted" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/dashboard_cards_empty_action"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/dialog_bank_title"
                    android:textColor="@color/text_primary"
                    app:backgroundTint="@color/dashboard_well"
                    app:icon="@drawable/ic_add"
                    app:iconSize="16dp"
                    app:iconTint="@color/text_primary" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Social Account section header (rows open the editor directly) -->
        <LinearLayout
            android:id="@+id/dashboard_header_social"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/trash_section_social"
                android:textAppearance="@style/TextAppearance.Akin.SectionTitle" />

        </LinearLayout>

        <!-- Social Account M3 card: filled vault surface hosting the account rows. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/dashboard_social_card"
            style="@style/Widget.Akin.DashboardCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/dashboard_social_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false" />

        </com.google.android.material.card.MaterialCardView>

        <!-- Empty state: M3 filled card, weight 1 stretches it to fill the rest
             of the screen. Tonal action + whole-card tap both open the creator. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/dashboard_social_empty_state"
            style="@style/Widget.Akin.DashboardCard"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"
            app:rippleColor="?attr/colorControlHighlight">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="16dp"
                android:paddingBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/empty_social_title"
                    android:textAppearance="@style/TextAppearance.Akin.CardTitle" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="@string/empty_social_sub"
                    android:textAppearance="@style/TextAppearance.Akin.BodyMuted" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/dashboard_social_empty_action"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/dialog_social_title"
                    android:textColor="@color/text_primary"
                    app:backgroundTint="@color/dashboard_well"
                    app:icon="@drawable/ic_add"
                    app:iconSize="16dp"
                    app:iconTint="@color/text_primary" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    <!-- Scrim: dims content while the quick-add menu is open; tap closes the menu -->
    <View
        android:id="@+id/dashboard_fab_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/text_shadow"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone" />

    <!-- M3 FAB menu: tonal pills (theme container, light label, blue icon),
         equal widths, trailing-edge aligned, 4dp FAB-to-menu gap. -->
    <LinearLayout
        android:id="@+id/dashboard_fab_menu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="76dp"
        android:orientation="vertical"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/dashboard_fab_option_id"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginBottom="8dp"
            android:text="@string/dialog_id_title"
            android:textColor="@color/text_primary"
            app:backgroundTint="@color/dashboard_surface"
            app:strokeColor="@color/dashboard_surface_border"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/dashboard_fab_option_card"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginBottom="8dp"
            android:text="@string/dialog_bank_title"
            android:textColor="@color/text_primary"
            app:backgroundTint="@color/dashboard_surface"
            app:strokeColor="@color/dashboard_surface_border"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/dashboard_fab_option_account"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:text="@string/dialog_social_title"
            android:textColor="@color/text_primary"
            app:backgroundTint="@color/dashboard_surface"
            app:strokeColor="@color/dashboard_surface_border"
            app:strokeWidth="1dp" />

    </LinearLayout>

    <!-- FAB menu close button: true circle via shape overlay (cornerSize is
         ignored by FAB), no compat padding so the 56dp visual sits exactly
         on the 16dp margins and clears the menu above it. -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/dashboard_fab_add"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:contentDescription="@string/fab_add"
        android:src="@drawable/ic_add"
        app:backgroundTint="?attr/colorPrimary"
        app:elevation="8dp"
        app:fabSize="normal"
        app:pressedTranslationZ="12dp"
        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Circle"
        app:tint="@color/white" />

    <!-- M3 SearchView: full-screen search experience. Its toolbar (back +
         field + clear) is built in; the containers below host the filtered
         vault, rebound with the same adapters as the dashboard. Fixed
         (not scrollable) with paddings/margins mirroring the dashboard
         content above so both screens line up exactly. -->
    <com.google.android.material.search.SearchView
        android:id="@+id/dashboard_search_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:theme="@style/ThemeOverlay.Material3.Dark"
        app:backgroundTint="@color/dashboard_bg_start">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="16dp"
                android:paddingBottom="16dp">

                <LinearLayout
                    android:id="@+id/dashboard_search_header_ids"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/trash_section_ids"
                        android:textAppearance="@style/TextAppearance.Akin.SectionTitle" />

                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/dashboard_search_ids_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:clipToPadding="false"
                    android:orientation="horizontal"
                    android:paddingEnd="36dp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/dashboard_search_header_cards"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/trash_section_cards"
                        android:textAppearance="@style/TextAppearance.Akin.SectionTitle" />

                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/dashboard_search_cards_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:clipToPadding="false"
                    android:orientation="horizontal"
                    android:paddingEnd="36dp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/dashboard_search_header_social"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/trash_section_social"
                        android:textAppearance="@style/TextAppearance.Akin.SectionTitle" />

                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/dashboard_search_social_card"
                    style="@style/Widget.Akin.DashboardCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:visibility="gone">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/dashboard_search_social_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipToPadding="false"
                        android:nestedScrollingEnabled="false" />

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/dashboard_search_empty_state"
                    style="@style/Widget.Akin.DashboardCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingTop="20dp"
                        android:paddingBottom="20dp">

                        <TextView
                            android:id="@+id/dashboard_search_empty_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="@string/search_empty_title"
                            android:textAppearance="@style/TextAppearance.Akin.CardTitle" />

                        <TextView
                            android:id="@+id/dashboard_search_empty_subtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center"
                            android:text="@string/search_empty_sub"
                            android:textAppearance="@style/TextAppearance.Akin.BodyMuted" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

    </com.google.android.material.search.SearchView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
