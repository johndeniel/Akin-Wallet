<?xml version="1.0" encoding="utf-8"?>
<!-- ============================================================
     Akin Wallet — app lock (launcher). Senior passcode system:
     real 3D Akin mark floating on a halo (no generic lock tile),
     glass keypad, glowing PIN dots, biometric medallion.
     Fixed layout — not scrollable. All IDs preserved for
     LockActivity (dots, keypad, fingerprint).
     ============================================================ -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_lock_root"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="32dp"
    android:paddingEnd="32dp"
    android:paddingTop="48dp"
    android:paddingBottom="32dp">

    <!-- Brand hero: real Akin logo floating on a soft halo. -->
    <FrameLayout
        android:layout_width="148dp"
        android:layout_height="148dp">

        <View
            android:layout_width="148dp"
            android:layout_height="148dp"
            android:background="@drawable/bg_lock_halo" />

        <ImageView
            android:layout_width="116dp"
            android:layout_height="116dp"
            android:layout_gravity="center"
            android:contentDescription="@string/app_name"
            android:elevation="8dp"
            android:src="@mipmap/ic_launcher_foreground" />

    </FrameLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:letterSpacing="-0.01"
        android:text="@string/app_name"
        android:textColor="@color/text_primary"
        android:textSize="27sp"
        android:textStyle="bold" />

    <!-- Tagline / step helper — overridden per screen (old PIN, new PIN…). -->
    <TextView
        android:id="@+id/lock_tagline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:letterSpacing="0.22"
        android:text="@string/header_tagline"
        android:textColor="@color/dashboard_muted"
        android:textSize="11sp"
        android:textStyle="bold" />

    <!-- PIN status dots (4 = PIN length). 20dp slot fits the glow. -->
    <LinearLayout
        android:id="@+id/lock_pin_dots_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="26dp"
        android:gravity="center"
        android:orientation="horizontal">

        <View
            android:id="@+id/lock_dot_0"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:background="@drawable/bg_pin_dot_empty" />

        <View
            android:id="@+id/lock_dot_1"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="16dp"
            android:background="@drawable/bg_pin_dot_empty" />

        <View
            android:id="@+id/lock_dot_2"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="16dp"
            android:background="@drawable/bg_pin_dot_empty" />

        <View
            android:id="@+id/lock_dot_3"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="16dp"
            android:background="@drawable/bg_pin_dot_empty" />

    </LinearLayout>

    <TextView
        android:id="@+id/lock_error_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:minHeight="20dp"
        android:text=""
        android:textColor="@color/danger_bright"
        android:textSize="13sp" />

    <!-- Glass numeric keypad. 74dp targets, royal pressed glow. -->
    <LinearLayout
        android:id="@+id/lock_keypad"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/lock_key_1"
                android:layout_width="74dp"
                android:layout_height="74dp"
                android:background="@drawable/bg_pin_key"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"

                android:gravity="center"
                android:text="1"
                android:textColor="@color/text_primary"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/lock_key_2"
                android:layout_width="74dp"
                android:layout_height="74dp"
                android:layout_marginStart="14dp"
                android:background="@drawable/bg_pin_key"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"

                android:gravity="center"
                android:text="2"
                android:textColor="@color/text_primary"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/lock_key_3"
                android:layout_width="74dp"
                android:layout_height="74dp"
                android:layout_marginStart="14dp"
                android:background="@drawable/bg_pin_key"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"

                android:gravity="center"
                android:text="3"
                android:textColor="@color/text_primary"
                android:textSize="24sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/lock_key_4"
                android:layout_width="74dp"
                android:layout_height="74dp"
                android:background="@drawable/bg_pin_key"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"

                android:gravity="center"
                android:text="4"
                android:textColor="@color/text_primary"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/lock_key_5"
                android:layout_width="74dp"
                android:layout_height="74dp"
                android:layout_marginStart="14dp"
                android:background="@drawable/bg_pin_key"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"

                android:gravity="center"
                android:text="5"
                android:textColor="@color/text_primary"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/lock_key_6"
                android:layout_width="74dp"
                android:layout_height="74dp"
                android:layout_marginStart="14dp"
                android:background="@drawable/bg_pin_key"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"

                android:gravity="center"
                android:text="6"
                android:textColor="@color/text_primary"
                android:textSize="24sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/lock_key_7"
                android:layout_width="74dp"
                android:layout_height="74dp"
                android:background="@drawable/bg_pin_key"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"

                android:gravity="center"
                android:text="7"
                android:textColor="@color/text_primary"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/lock_key_8"
                android:layout_width="74dp"
                android:layout_height="74dp"
                android:layout_marginStart="14dp"
                android:background="@drawable/bg_pin_key"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"

                android:gravity="center"
                android:text="8"
                android:textColor="@color/text_primary"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/lock_key_9"
                android:layout_width="74dp"
                android:layout_height="74dp"
                android:layout_marginStart="14dp"
                android:background="@drawable/bg_pin_key"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"

                android:gravity="center"
                android:text="9"
                android:textColor="@color/text_primary"
                android:textSize="24sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/lock_key_biometric"
                android:layout_width="74dp"
                android:layout_height="74dp"
                android:background="@drawable/bg_pin_key"
                android:clickable="true"
                android:focusable="true"

                android:visibility="invisible">

                    <ImageView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/lock_use_fingerprint"
                        android:src="@drawable/fingerprint"
                        android:tint="@color/white" />

            </FrameLayout>

            <TextView
                android:id="@+id/lock_key_0"
                android:layout_width="74dp"
                android:layout_height="74dp"
                android:layout_marginStart="14dp"
                android:background="@drawable/bg_pin_key"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"

                android:gravity="center"
                android:text="0"
                android:textColor="@color/text_primary"
                android:textSize="24sp" />

            <FrameLayout
                android:id="@+id/lock_key_backspace"
                android:layout_width="74dp"
                android:layout_height="74dp"
                android:layout_marginStart="14dp"
                android:background="@drawable/bg_pin_key"
                android:clickable="true"
                android:focusable="true"
>

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/cd_back"
                    android:src="@drawable/ic_backspace" />

            </FrameLayout>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
