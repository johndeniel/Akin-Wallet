<?xml version="1.0" encoding="utf-8"?>
<!-- App lock. Fixed, compact tokens. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_lock_root"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="@dimen/lock_screen_padding_horizontal"
    android:paddingEnd="@dimen/lock_screen_padding_horizontal"
    android:paddingTop="@dimen/lock_screen_padding_top"
    android:paddingBottom="@dimen/lock_screen_padding_bottom">

    <FrameLayout
        android:layout_width="@dimen/lock_halo_size"
        android:layout_height="@dimen/lock_halo_size">

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_lock_halo" />

        <ImageView
            android:layout_width="@dimen/lock_logo_size"
            android:layout_height="@dimen/lock_logo_size"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:elevation="@dimen/lock_logo_elevation"
            android:src="@mipmap/ic_launcher_foreground" />

    </FrameLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/lock_title_gap"
        android:letterSpacing="-0.01"
        android:maxLines="1"
        android:ellipsize="end"
        android:accessibilityHeading="true"
        android:text="@string/app_name"
        android:textColor="@color/text_primary"
        android:textSize="27sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/lock_step_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_8dp"
        android:letterSpacing="0.22"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="@string/header_tagline"
        android:textColor="@color/dashboard_muted"
        android:textSize="11sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/lock_pin_indicator_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/lock_dots_gap_top"
        android:gravity="center"
        android:orientation="horizontal">

        <View
            android:id="@+id/lock_pin_indicator_1"
            android:layout_width="@dimen/lock_dot_size"
            android:layout_height="@dimen/lock_dot_size"
            android:background="@drawable/bg_pin_dot_empty" />

        <View
            android:id="@+id/lock_pin_indicator_2"
            android:layout_width="@dimen/lock_dot_size"
            android:layout_height="@dimen/lock_dot_size"
            android:layout_marginStart="@dimen/lock_dot_gap"
            android:background="@drawable/bg_pin_dot_empty" />

        <View
            android:id="@+id/lock_pin_indicator_3"
            android:layout_width="@dimen/lock_dot_size"
            android:layout_height="@dimen/lock_dot_size"
            android:layout_marginStart="@dimen/lock_dot_gap"
            android:background="@drawable/bg_pin_dot_empty" />

        <View
            android:id="@+id/lock_pin_indicator_4"
            android:layout_width="@dimen/lock_dot_size"
            android:layout_height="@dimen/lock_dot_size"
            android:layout_marginStart="@dimen/lock_dot_gap"
            android:background="@drawable/bg_pin_dot_empty" />

    </LinearLayout>

    <TextView
        android:id="@+id/lock_error_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/lock_error_gap_top"
        android:gravity="center"
        android:minHeight="@dimen/lock_error_height"
        android:accessibilityLiveRegion="polite"
        android:text=""
        android:textColor="@color/danger_bright"
        android:textSize="13sp" />

    <LinearLayout
        android:id="@+id/lock_keypad"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/lock_keypad_gap_top"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/lock_keypad_digit_1"
                style="@style/Widget.Akin.LockKey"
                android:layout_width="@dimen/lock_key_size"
                android:layout_height="@dimen/lock_key_size"
                android:text="1" />

            <TextView
                android:id="@+id/lock_keypad_digit_2"
                style="@style/Widget.Akin.LockKey"
                android:layout_width="@dimen/lock_key_size"
                android:layout_height="@dimen/lock_key_size"
                android:layout_marginStart="@dimen/lock_key_gap"
                android:text="2" />

            <TextView
                android:id="@+id/lock_keypad_digit_3"
                style="@style/Widget.Akin.LockKey"
                android:layout_width="@dimen/lock_key_size"
                android:layout_height="@dimen/lock_key_size"
                android:layout_marginStart="@dimen/lock_key_gap"
                android:text="3" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/lock_key_row_gap"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/lock_keypad_digit_4"
                style="@style/Widget.Akin.LockKey"
                android:layout_width="@dimen/lock_key_size"
                android:layout_height="@dimen/lock_key_size"
                android:text="4" />

            <TextView
                android:id="@+id/lock_keypad_digit_5"
                style="@style/Widget.Akin.LockKey"
                android:layout_width="@dimen/lock_key_size"
                android:layout_height="@dimen/lock_key_size"
                android:layout_marginStart="@dimen/lock_key_gap"
                android:text="5" />

            <TextView
                android:id="@+id/lock_keypad_digit_6"
                style="@style/Widget.Akin.LockKey"
                android:layout_width="@dimen/lock_key_size"
                android:layout_height="@dimen/lock_key_size"
                android:layout_marginStart="@dimen/lock_key_gap"
                android:text="6" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/lock_key_row_gap"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/lock_keypad_digit_7"
                style="@style/Widget.Akin.LockKey"
                android:layout_width="@dimen/lock_key_size"
                android:layout_height="@dimen/lock_key_size"
                android:text="7" />

            <TextView
                android:id="@+id/lock_keypad_digit_8"
                style="@style/Widget.Akin.LockKey"
                android:layout_width="@dimen/lock_key_size"
                android:layout_height="@dimen/lock_key_size"
                android:layout_marginStart="@dimen/lock_key_gap"
                android:text="8" />

            <TextView
                android:id="@+id/lock_keypad_digit_9"
                style="@style/Widget.Akin.LockKey"
                android:layout_width="@dimen/lock_key_size"
                android:layout_height="@dimen/lock_key_size"
                android:layout_marginStart="@dimen/lock_key_gap"
                android:text="9" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/lock_key_row_gap"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/lock_keypad_biometric"
                android:layout_width="@dimen/lock_key_size"
                android:layout_height="@dimen/lock_key_size"
                android:background="@drawable/bg_pin_key"
                android:clickable="true"
                android:focusable="true"
                android:visibility="invisible">

                <ImageView
                    android:layout_width="@dimen/lock_key_icon_medium"
                    android:layout_height="@dimen/lock_key_icon_medium"
                    android:layout_gravity="center"
                    android:contentDescription="@string/lock_use_fingerprint"
                    android:src="@drawable/fingerprint"
                    android:tint="@color/white" />

            </FrameLayout>

            <TextView
                android:id="@+id/lock_keypad_digit_0"
                style="@style/Widget.Akin.LockKey"
                android:layout_width="@dimen/lock_key_size"
                android:layout_height="@dimen/lock_key_size"
                android:layout_marginStart="@dimen/lock_key_gap"
                android:text="0" />

            <FrameLayout
                android:id="@+id/lock_keypad_backspace"
                android:layout_width="@dimen/lock_key_size"
                android:layout_height="@dimen/lock_key_size"
                android:layout_marginStart="@dimen/lock_key_gap"
                android:background="@drawable/bg_pin_key"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/cd_backspace">

                <ImageView
                    android:layout_width="@dimen/lock_key_icon_small"
                    android:layout_height="@dimen/lock_key_icon_small"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_backspace" />

            </FrameLayout>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
