<?xml version="1.0" encoding="utf-8"?>
<!-- Social account form: dashboard-navy theme (bg_dashboard_root,
     bg_dashboard_card rows, dashboard_muted labels) shared with the bank and
     government ID forms. M3 toolbar with back + title, same insets as
     Settings. Platform picking is an in-place full-screen M3 SearchView
     (no separate activity): CoordinatorLayout root hosts its transition.
     Twin outline action row (save + edit-only delete)
     copied from the bank card form; keep the rows in sync. -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".activity.SocialAccountActivity"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_dashboard_root">

<androidx.core.widget.NestedScrollView
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="16dp"
    android:paddingBottom="24dp">

    <!-- M3 small top app bar: 64dp, nav icon + title. Same insets as Settings
         so all headers match. -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/social_account_toolbar"
        style="@style/Widget.Akin.Toolbar"
        android:layout_width="match_parent"
        app:title="@string/dialog_social_title" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/field_platform"
        android:textColor="@color/dashboard_muted"
        android:textSize="13sp"
        android:layout_marginTop="12dp" />

    <LinearLayout
        android:id="@+id/social_account_platform_selector"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_dashboard_card"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/social_account_selector_icon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:adjustViewBounds="true"
            android:background="@drawable/bg_dashboard_icon_white"
            android:scaleType="fitCenter"
            android:padding="7dp"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/social_account_selector_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_dropdown"
            android:contentDescription="@string/cd_select_platform" />

    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/section_account_details"
        android:textColor="@color/dashboard_muted"
        android:textSize="13sp"
        android:layout_marginTop="24dp" />

    <!-- Username row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_dashboard_card"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp"
        android:paddingVertical="12dp"
        android:layout_marginTop="8dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_person"
            android:alpha="0.6"
            android:contentDescription="@null"
            android:layout_marginEnd="14dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/field_username"
                android:textColor="@color/dashboard_muted"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/social_account_input_username"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:hint="@string/hint_username"
                android:textColorHint="@color/hint_text"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:singleLine="true"
                android:inputType="textEmailAddress"
                android:paddingTop="2dp"
                android:paddingBottom="4dp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Password row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_dashboard_card"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp"
        android:paddingVertical="12dp"
        android:layout_marginTop="8dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_lock"
            android:alpha="0.6"
            android:contentDescription="@null"
            android:layout_marginEnd="14dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/field_password"
                android:textColor="@color/dashboard_muted"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/social_account_input_password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:hint="@string/mask_password"
                android:textColorHint="@color/hint_text"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:singleLine="true"
                android:inputType="textPassword"
                android:paddingTop="2dp"
                android:paddingBottom="4dp" />

        </LinearLayout>

        <ImageView
            android:id="@+id/social_account_toggle_password_visibility"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_eye"
            android:alpha="0.6"
            android:layout_marginStart="8dp"
            android:contentDescription="@string/cd_toggle_visibility" />

    </LinearLayout>

    <!-- PIN row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_dashboard_card"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp"
        android:paddingVertical="12dp"
        android:layout_marginTop="8dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_lock"
            android:alpha="0.6"
            android:contentDescription="@null"
            android:layout_marginEnd="14dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/field_pin"
                android:textColor="@color/dashboard_muted"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/social_account_input_pin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:hint="@string/mask_pin"
                android:textColorHint="@color/hint_text"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:singleLine="true"
                android:inputType="numberPassword"
                android:maxLength="6"
                android:paddingTop="2dp"
                android:paddingBottom="4dp" />

        </LinearLayout>

        <ImageView
            android:id="@+id/social_account_toggle_pin_visibility"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_eye"
            android:alpha="0.6"
            android:layout_marginStart="8dp"
            android:contentDescription="@string/cd_toggle_visibility" />

    </LinearLayout>

    <!-- Associated accounts: dashboard-style section header (bold title left,
         icon-only Add button right) over a dashboard card holding the rows.
         The card is hidden entirely when nothing is linked. -->
    <LinearLayout
        android:id="@+id/social_account_linked_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_associated_accounts"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <LinearLayout
                android:id="@+id/social_account_add_linked_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_button_outline"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="8dp"
                android:contentDescription="@string/cd_add_account">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_add_circle"
                    android:importantForAccessibility="no" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/social_account_linked_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_dashboard_card"
            android:orientation="vertical"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/social_account_linked_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:overScrollMode="never"
                android:nestedScrollingEnabled="false" />

        </LinearLayout>

    </LinearLayout>

    <!-- Save/Delete action row, same twin-outline pattern as the bank and
         government ID forms. Delete shows in edit mode only. -->
    <include layout="@layout/partial_form_action_row" />

</LinearLayout>

</androidx.core.widget.NestedScrollView>
    <!-- M3 platform SearchView: full-screen picker opened from the platform
         selector above. Same adapters/rows as the old picker activity;
         typing filters the catalog, tapping a row picks it and closes. -->
    <com.google.android.material.search.SearchView
        android:id="@+id/social_account_platform_search_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:hint="@string/hint_search_platforms"
        android:theme="@style/ThemeOverlay.Material3.Dark"
        app:backgroundTint="@color/dashboard_bg_start">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/social_account_platform_search_list"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:overScrollMode="never" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/social_account_platform_empty_state"
                style="@style/Widget.Akin.DashboardCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/empty_platforms"
                        android:textAppearance="@style/TextAppearance.Akin.CardTitle" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:text="@string/search_empty_sub"
                        android:textAppearance="@style/TextAppearance.Akin.BodyMuted" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </com.google.android.material.search.SearchView>

    <!-- M3 link-account SearchView: in-place picker opened from the Add
         action in Associated Accounts. Same rows as the old picker
         activity; tapping a row links it and closes. -->
    <com.google.android.material.search.SearchView
        android:id="@+id/social_account_link_search_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:hint="@string/hint_search_accounts"
        android:theme="@style/ThemeOverlay.Material3.Dark"
        app:backgroundTint="@color/dashboard_bg_start">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/social_account_link_search_list"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:overScrollMode="never" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/social_account_link_empty_state"
                style="@style/Widget.Akin.DashboardCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/empty_accounts"
                        android:textAppearance="@style/TextAppearance.Akin.CardTitle" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:text="@string/search_empty_sub"
                        android:textAppearance="@style/TextAppearance.Akin.BodyMuted" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </com.google.android.material.search.SearchView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
