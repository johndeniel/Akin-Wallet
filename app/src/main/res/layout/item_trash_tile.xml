<?xml version="1.0" encoding="utf-8"?>
<!-- Trash tile: centered icon + title + masked hint, two-per-row. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/trash_tile_card"
    style="@style/Widget.Akin.DashboardCard"
    android:layout_width="match_parent"
    android:layout_height="@dimen/trash_tile_height"
    android:layout_margin="@dimen/trash_tile_margin"
    android:clickable="true"
    android:focusable="true">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="@dimen/row_content_padding_start"
            android:paddingEnd="@dimen/row_content_padding_start"
            android:paddingTop="@dimen/spacing_20dp"
            android:paddingBottom="@dimen/spacing_20dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/trash_tile_icon"
                android:layout_width="@dimen/trash_tile_icon_size"
                android:layout_height="@dimen/trash_tile_icon_size"
                android:background="@color/white"
                android:scaleType="fitCenter"
                app:contentPadding="@dimen/spacing_8dp"
                app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Akin.Rounded12" />

            <TextView
                android:id="@+id/trash_tile_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_10dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:singleLine="true"
                android:textAppearance="@style/TextAppearance.Akin.CardTitle" />

            <TextView
                android:id="@+id/trash_tile_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_2dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:singleLine="true"
                android:textAppearance="@style/TextAppearance.Akin.BodyMuted" />

        </LinearLayout>

        <FrameLayout
            android:id="@+id/trash_tile_selection_badge"
            android:layout_width="@dimen/trash_badge_size"
            android:layout_height="@dimen/trash_badge_size"
            android:layout_gravity="top|end"
            android:layout_margin="@dimen/spacing_8dp"
            android:background="@drawable/bg_check_badge"
            android:visibility="gone">

            <ImageView
                android:layout_width="@dimen/spacing_14dp"
                android:layout_height="@dimen/spacing_14dp"
                android:layout_gravity="center"
                android:contentDescription="@string/trash_restore"
                android:src="@drawable/ic_check" />

        </FrameLayout>

    </FrameLayout>

</com.google.android.material.card.MaterialCardView>
