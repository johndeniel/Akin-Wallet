<?xml version="1.0" encoding="utf-8"?>
<!-- Social Account row (item_social_account): M3 list item (rounded icon well + title/
     supporting text + trailing chevron) with M3 ripple and divider.
     Hairline divider below every row except the last (toggled by adapter). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="8dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/social_account_icon"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@color/white"
            android:contentDescription="@string/cd_platform"
            android:scaleType="fitCenter"
            android:src="@drawable/google"
            app:contentPadding="5dp"
            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Akin.Rounded12" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

        <TextView
            android:id="@+id/social_account_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:singleLine="true"
            android:textAppearance="@style/TextAppearance.Akin.CardTitle"
            tools:text="Platform" />

            <TextView
                android:id="@+id/social_account_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:singleLine="true"
                android:textAppearance="@style/TextAppearance.Akin.BodyMuted"
                tools:text="username" />

        </LinearLayout>

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="8dp"
            android:alpha="0.6"
            android:contentDescription="@null"
            android:src="@drawable/ic_chevron_right"
            android:tint="@color/dashboard_muted" />

    </LinearLayout>

    <com.google.android.material.divider.MaterialDivider
        android:id="@+id/social_account_divider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:dividerColor="@color/dashboard_surface_border"
        app:dividerInsetEnd="8dp"
        app:dividerInsetStart="12dp"
        app:dividerThickness="1dp" />

</LinearLayout>
