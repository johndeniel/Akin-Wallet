<?xml version="1.0" encoding="utf-8"?>
<!-- ============================================================
     Akin Wallet — Settings. M3 filled cards
     (Widget.Akin.DashboardCard) with ShapeableImageView icon wells,
     MaterialDivider hairlines and M3 text appearances for section
     labels, row titles and supporting text.
     Ripple matches item_social_account: each row is a
     full-bleed vertical container (clickable + foreground ripple,
     no padding) holding a padded content row; its divider lives
     INSIDE the ripple container with 12dp/8dp insets.
     ============================================================ -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".activity.SettingsActivity"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_dashboard_root"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- M3 small top app bar: 64dp, nav icon + two-line headline. The -12dp
         margin pulls the 48dp nav target to the padding edge; insets are
         zeroed so the title sits a fixed 12dp past the arrow. -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/settings_toolbar"
        style="@style/Widget.Akin.Toolbar"
        android:layout_width="match_parent"
        app:title="@string/settings_title" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/settings_section_security"
        android:textAppearance="@style/TextAppearance.Akin.SectionLabel" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        style="@style/Widget.Akin.DashboardCard">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Biometric unlock toggle (not clickable — switch only). -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@color/white"
                        android:contentDescription="@string/settings_biometric"
                        android:scaleType="fitCenter"
                        android:src="@drawable/fingerprint"
                        app:contentPadding="8dp"
                        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Akin.Rounded12" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_biometric"
                            android:textAppearance="@style/TextAppearance.Akin.CardTitle" />

                        <TextView
                            android:id="@+id/settings_biometric_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/settings_biometric_off"
                            android:textAppearance="@style/TextAppearance.Akin.BodyMuted" />

                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/settings_biometric_switch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:contentDescription="@string/settings_biometric" />

                </LinearLayout>

                <com.google.android.material.divider.MaterialDivider
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:dividerColor="@color/dashboard_surface_border"
                    app:dividerInsetEnd="8dp"
                    app:dividerInsetStart="12dp"
                    app:dividerThickness="1dp" />

            </LinearLayout>

            <!-- Change app PIN. -->
            <LinearLayout
                android:id="@+id/settings_row_change_pin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@color/white"
                        android:contentDescription="@string/settings_change_pin"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_lock"
                        app:contentPadding="8dp"
                        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Akin.Rounded12" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_change_pin"
                            android:textAppearance="@style/TextAppearance.Akin.CardTitle" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/settings_change_pin_sub"
                            android:textAppearance="@style/TextAppearance.Akin.BodyMuted" />

                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="8dp"
                        android:src="@drawable/ic_chevron_right"
                        android:contentDescription="@string/settings_change_pin" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Trash: soft-deleted IDs, bank cards and social accounts. Opens the
         Trash screen where items can be restored or deleted forever. -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/settings_section_wallet"
        android:textAppearance="@style/TextAppearance.Akin.SectionLabel" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        style="@style/Widget.Akin.DashboardCard">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/settings_row_trash"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@color/white"
                        android:contentDescription="@string/settings_trash"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_trash"
                        app:contentPadding="8dp"
                        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Akin.Rounded12" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_trash"
                            android:textAppearance="@style/TextAppearance.Akin.CardTitle" />

                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="8dp"
                        android:src="@drawable/ic_chevron_right"
                        android:contentDescription="@string/settings_trash" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/settings_section_legal"
        android:textAppearance="@style/TextAppearance.Akin.SectionLabel" />

    <!-- Legal: in-app Privacy Policy and Terms screens. Same row language
         as the cards above (icon well + title). -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        style="@style/Widget.Akin.DashboardCard">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/settings_row_privacy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@color/white"
                        android:contentDescription="@string/settings_privacy"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_privacy"
                        app:contentPadding="8dp"
                        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Akin.Rounded12" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_privacy"
                            android:textAppearance="@style/TextAppearance.Akin.CardTitle" />

                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="8dp"
                        android:src="@drawable/ic_chevron_right"
                        android:contentDescription="@string/settings_privacy" />

                </LinearLayout>

                <com.google.android.material.divider.MaterialDivider
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:dividerColor="@color/dashboard_surface_border"
                    app:dividerInsetEnd="8dp"
                    app:dividerInsetStart="12dp"
                    app:dividerThickness="1dp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/settings_row_terms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@color/white"
                        android:contentDescription="@string/settings_terms"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_terms"
                        app:contentPadding="8dp"
                        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Akin.Rounded12" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_terms"
                            android:textAppearance="@style/TextAppearance.Akin.CardTitle" />

                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="8dp"
                        android:src="@drawable/ic_chevron_right"
                        android:contentDescription="@string/settings_terms" />

                </LinearLayout>

                <com.google.android.material.divider.MaterialDivider
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:dividerColor="@color/dashboard_surface_border"
                    app:dividerInsetEnd="8dp"
                    app:dividerInsetStart="12dp"
                    app:dividerThickness="1dp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/settings_row_about"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@color/white"
                        android:contentDescription="@string/settings_about"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_info"
                        app:contentPadding="8dp"
                        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Akin.Rounded12" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_about"
                            android:textAppearance="@style/TextAppearance.Akin.CardTitle" />

                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="8dp"
                        android:src="@drawable/ic_chevron_right"
                        android:contentDescription="@string/settings_about" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- App version footer, stamped at runtime (falls back to 1.0). -->
    <TextView
        android:id="@+id/settings_version"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.Akin.BodyMuted" />

</LinearLayout>
