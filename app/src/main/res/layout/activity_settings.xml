<?xml version="1.0" encoding="utf-8"?>
<!-- Settings. Fixed, compact tokens. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".activity.SettingsActivity"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_dashboard_root"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_gutter_horizontal"
    android:paddingEnd="@dimen/screen_gutter_horizontal"
    android:paddingTop="@dimen/screen_padding_top"
    android:paddingBottom="@dimen/screen_padding_bottom">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.Akin.Toolbar"
        android:layout_width="match_parent"
        app:title="@string/settings_title" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/section_gap_top"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="@string/settings_section_security"
        android:textAppearance="@style/TextAppearance.Akin.SectionLabel"
        android:accessibilityHeading="true" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/section_header_gap"
        style="@style/Widget.Akin.DashboardCard">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    style="@style/Widget.Akin.SettingsRowContent">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:layout_width="@dimen/row_icon_well_size"
                        android:layout_height="@dimen/row_icon_well_size"
                        android:background="@color/white"
                        android:importantForAccessibility="no"
                        android:scaleType="fitCenter"
                        android:src="@drawable/fingerprint"
                        app:contentPadding="@dimen/row_icon_content_padding"
                        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Akin.Rounded12" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/row_title_icon_gap"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_biometric"
                            android:textAppearance="@style/TextAppearance.Akin.CardTitle"
                            android:maxLines="1"
                            android:ellipsize="end" />

                        <TextView
                            android:id="@+id/settings_biometric_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_2dp"
                            android:text="@string/settings_biometric_off"
                            android:textAppearance="@style/TextAppearance.Akin.BodyMuted"
                            android:maxLines="1"
                            android:ellipsize="end" />

                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/settings_biometric_switch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_8dp"
                        android:minWidth="48dp"
                        android:minHeight="48dp"
                        android:contentDescription="@string/settings_biometric" />

                </LinearLayout>

                <View
                    style="@style/Widget.Akin.HairlineDivider" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/settings_change_pin_row"
                style="@style/Widget.Akin.SettingsRow">

                <LinearLayout
                    style="@style/Widget.Akin.SettingsRowContent">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:layout_width="@dimen/row_icon_well_size"
                        android:layout_height="@dimen/row_icon_well_size"
                        android:background="@color/white"
                        android:contentDescription="@string/settings_change_pin"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_lock"
                        app:contentPadding="@dimen/row_icon_content_padding"
                        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Akin.Rounded12" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/row_title_icon_gap"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_change_pin"
                            android:textAppearance="@style/TextAppearance.Akin.CardTitle"
                            android:maxLines="1"
                            android:ellipsize="end" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_2dp"
                            android:text="@string/settings_change_pin_sub"
                            android:textAppearance="@style/TextAppearance.Akin.BodyMuted"
                            android:maxLines="1"
                            android:ellipsize="end" />

                    </LinearLayout>

                    <ImageView
                        android:layout_width="@dimen/row_trailing_icon_size"
                        android:layout_height="@dimen/row_trailing_icon_size"
                        android:layout_marginStart="@dimen/spacing_8dp"
                        android:src="@drawable/ic_chevron_right"
                        android:importantForAccessibility="no" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/section_gap_top"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="@string/settings_section_wallet"
        android:textAppearance="@style/TextAppearance.Akin.SectionLabel"
        android:accessibilityHeading="true" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/section_header_gap"
        style="@style/Widget.Akin.DashboardCard">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/settings_trash_row"
                style="@style/Widget.Akin.SettingsRow">

                <LinearLayout
                    style="@style/Widget.Akin.SettingsRowContent">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:layout_width="@dimen/row_icon_well_size"
                        android:layout_height="@dimen/row_icon_well_size"
                        android:background="@color/white"
                        android:contentDescription="@string/settings_trash"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_trash"
                        app:contentPadding="@dimen/row_icon_content_padding"
                        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Akin.Rounded12" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/row_title_icon_gap"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_trash"
                            android:textAppearance="@style/TextAppearance.Akin.CardTitle"
                            android:maxLines="1"
                            android:ellipsize="end" />

                    </LinearLayout>

                    <ImageView
                        android:layout_width="@dimen/row_trailing_icon_size"
                        android:layout_height="@dimen/row_trailing_icon_size"
                        android:layout_marginStart="@dimen/spacing_8dp"
                        android:src="@drawable/ic_chevron_right"
                        android:importantForAccessibility="no" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/section_gap_top"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="@string/settings_section_legal"
        android:textAppearance="@style/TextAppearance.Akin.SectionLabel"
        android:accessibilityHeading="true" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/section_header_gap"
        style="@style/Widget.Akin.DashboardCard">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/settings_privacy_row"
                style="@style/Widget.Akin.SettingsRow">

                <LinearLayout
                    style="@style/Widget.Akin.SettingsRowContent">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:layout_width="@dimen/row_icon_well_size"
                        android:layout_height="@dimen/row_icon_well_size"
                        android:background="@color/white"
                        android:contentDescription="@string/settings_privacy"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_privacy"
                        app:contentPadding="@dimen/row_icon_content_padding"
                        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Akin.Rounded12" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/row_title_icon_gap"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_privacy"
                            android:textAppearance="@style/TextAppearance.Akin.CardTitle"
                            android:maxLines="1"
                            android:ellipsize="end" />

                    </LinearLayout>

                    <ImageView
                        android:layout_width="@dimen/row_trailing_icon_size"
                        android:layout_height="@dimen/row_trailing_icon_size"
                        android:layout_marginStart="@dimen/spacing_8dp"
                        android:src="@drawable/ic_chevron_right"
                        android:importantForAccessibility="no" />

                </LinearLayout>

                <View
                    style="@style/Widget.Akin.HairlineDivider" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/settings_terms_row"
                style="@style/Widget.Akin.SettingsRow">

                <LinearLayout
                    style="@style/Widget.Akin.SettingsRowContent">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:layout_width="@dimen/row_icon_well_size"
                        android:layout_height="@dimen/row_icon_well_size"
                        android:background="@color/white"
                        android:contentDescription="@string/settings_terms"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_terms"
                        app:contentPadding="@dimen/row_icon_content_padding"
                        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Akin.Rounded12" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/row_title_icon_gap"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_terms"
                            android:textAppearance="@style/TextAppearance.Akin.CardTitle"
                            android:maxLines="1"
                            android:ellipsize="end" />

                    </LinearLayout>

                    <ImageView
                        android:layout_width="@dimen/row_trailing_icon_size"
                        android:layout_height="@dimen/row_trailing_icon_size"
                        android:layout_marginStart="@dimen/spacing_8dp"
                        android:src="@drawable/ic_chevron_right"
                        android:importantForAccessibility="no" />

                </LinearLayout>

                <View
                    style="@style/Widget.Akin.HairlineDivider" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/settings_about_row"
                style="@style/Widget.Akin.SettingsRow">

                <LinearLayout
                    style="@style/Widget.Akin.SettingsRowContent">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:layout_width="@dimen/row_icon_well_size"
                        android:layout_height="@dimen/row_icon_well_size"
                        android:background="@color/white"
                        android:contentDescription="@string/settings_about"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_info"
                        app:contentPadding="@dimen/row_icon_content_padding"
                        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Akin.Rounded12" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/row_title_icon_gap"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_about"
                            android:textAppearance="@style/TextAppearance.Akin.CardTitle"
                            android:maxLines="1"
                            android:ellipsize="end" />

                    </LinearLayout>

                    <ImageView
                        android:layout_width="@dimen/row_trailing_icon_size"
                        android:layout_height="@dimen/row_trailing_icon_size"
                        android:layout_marginStart="@dimen/spacing_8dp"
                        android:src="@drawable/ic_chevron_right"
                        android:importantForAccessibility="no" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/settings_version_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/section_gap_top"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="end"
        android:textAppearance="@style/TextAppearance.Akin.BodyMuted" />

</LinearLayout>
