<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".activity.BankCardActivity"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_dashboard_root"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="24dp">

        <!-- M3 small top app bar: 64dp, nav icon + title. Same insets as Settings
             so all headers match. -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/bank_card_toolbar"
            style="@style/Widget.Akin.Toolbar"
            android:layout_width="match_parent"
            app:title="@string/dialog_bank_title" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/bank_card_design_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:clipToPadding="false"
            android:paddingEnd="36dp"
            android:overScrollMode="never" />

        <LinearLayout
            android:id="@+id/bank_card_design_dots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/field_card_type"
                    android:textColor="@color/dashboard_muted"
                    android:textSize="13sp" />

                <LinearLayout
                    android:id="@+id/bank_card_type_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_dashboard_card"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="14dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/bank_card_type_value"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/default_card_type"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:singleLine="true" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_dropdown"
                        android:contentDescription="@string/cd_select_card_type" />

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/field_card_network"
                    android:textColor="@color/dashboard_muted"
                    android:textSize="13sp" />

                <LinearLayout
                    android:id="@+id/bank_card_network_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_dashboard_card"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="14dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/bank_card_network_value"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/default_card_network"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:singleLine="true" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_dropdown"
                        android:contentDescription="@string/cd_select_card_network" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/field_bank_name"
            android:textColor="@color/dashboard_muted"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/bank_card_input_bank_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_dashboard_card"
            android:hint="@string/hint_bank_name"
            android:textColorHint="@color/hint_text"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:singleLine="true"
            android:inputType="textCapWords"
            android:paddingHorizontal="16dp"
            android:paddingVertical="14dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/field_holder_name"
            android:textColor="@color/dashboard_muted"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/bank_card_input_holder_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_dashboard_card"
            android:hint="@string/hint_person_name"
            android:textColorHint="@color/hint_text"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:singleLine="true"
            android:inputType="textCapWords"
            android:paddingHorizontal="16dp"
            android:paddingVertical="14dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/field_card_number"
                    android:textColor="@color/dashboard_muted"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/bank_card_input_card_number"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_dashboard_card"
                    android:hint="@string/hint_card_number"
                    android:textColorHint="@color/hint_text"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:singleLine="true"
                    android:inputType="number"
                    android:maxLength="23"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="14dp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/field_expiry"
                    android:textColor="@color/dashboard_muted"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/bank_card_input_expiry"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_dashboard_card"
                    android:hint="@string/hint_expiry"
                    android:textColorHint="@color/hint_text"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:singleLine="true"
                    android:inputType="number"
                    android:maxLength="5"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="14dp" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/field_cvv"
                    android:textColor="@color/dashboard_muted"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_dashboard_card"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="4dp">

                    <EditText
                        android:id="@+id/bank_card_input_cvv"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="@string/hint_cvv"
                        android:textColorHint="@color/hint_text"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:singleLine="true"
                        android:inputType="numberPassword"
                        android:maxLength="3"
                        android:paddingVertical="10dp" />

                    <ImageView
                        android:id="@+id/bank_card_toggle_cvv_visibility"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_eye"
                        android:alpha="0.6"
                        android:layout_marginStart="8dp"
                        android:contentDescription="@string/cd_toggle_visibility" />

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/field_pin"
                    android:textColor="@color/dashboard_muted"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_dashboard_card"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="4dp">

                    <EditText
                        android:id="@+id/bank_card_input_pin"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="@string/mask_pin"
                        android:textColorHint="@color/hint_text"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:singleLine="true"
                        android:inputType="numberPassword"
                        android:maxLength="6"
                        android:paddingVertical="10dp" />

                    <ImageView
                        android:id="@+id/bank_card_toggle_pin_visibility"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_eye"
                        android:alpha="0.6"
                        android:layout_marginStart="8dp"
                        android:contentDescription="@string/cd_toggle_visibility" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <include layout="@layout/partial_form_action_row" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
