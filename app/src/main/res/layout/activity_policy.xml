<?xml version="1.0" encoding="utf-8"?>
<!-- Policy — static legal text (Privacy Policy or Terms). Uncarded sections:
     accent-blue letterspaced heading over light body copy, built row by row
     by PolicyActivity from the bundled string. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".activity.PolicyActivity"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_dashboard_root"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="24dp">

        <!-- M3 small top app bar: 64dp, nav icon + two-line headline. Title is
             set per type by PolicyActivity; same insets as Settings. -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/policy_toolbar"
            style="@style/Widget.Akin.Toolbar"
            android:layout_width="match_parent"
            app:title="@string/settings_privacy" />

        <LinearLayout
            android:id="@+id/policy_sections"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
