<?xml version="1.0" encoding="utf-8"?>
<!-- Government ID face, 1.586:1. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <FrameLayout
            android:id="@+id/government_id_card_root"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginHorizontal="4dp"
            android:elevation="2dp"
            android:background="@drawable/bg_national_id"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="H,1.586:1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="14dp"
                android:paddingBottom="12dp">

                <TextView
                    android:id="@+id/government_id_title"
                    style="@style/IdFaceTitle"
                    android:text="@string/preview_government_id"
                    android:textColor="@color/national_ink"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/government_id_subtitle"
                    style="@style/IdFaceSubtitle"
                    android:text="@string/preview_government_id"
                    android:textColor="@color/national_muted"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <View
                    android:id="@+id/government_id_rule"
                    style="@style/IdFaceRule"
                    android:background="@color/national_rule" />

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <!-- Photo + identity data: portrait photo left, compact data
                     grid right (name, number, then date-of-birth/expiry pair,
                     then address). Short date fields share one row so the
                     fixed-height face never overflows. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal"
                    android:gravity="top">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <FrameLayout
                            android:id="@+id/government_id_photo_box"
                            android:layout_width="46dp"
                            android:layout_height="60dp"
                            android:elevation="2dp"
                            android:background="@drawable/bg_id_photo_placeholder">

                            <ImageView
                                android:id="@+id/government_id_photo_icon"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_person"
                                android:importantForAccessibility="no" />

                        </FrameLayout>

                        <com.akin.wallet.util.BarcodeView
                            android:id="@+id/government_id_barcode"
                            android:layout_width="wrap_content"
                            android:layout_height="8dp"
                            android:layout_marginTop="4dp" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/government_id_holder_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/preview_person_name"
                            android:textColor="@color/national_muted"
                            android:textSize="8sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.26"
                            android:singleLine="true"
                            android:ellipsize="end" />

                        <TextView
                            android:id="@+id/government_id_holder"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/preview_person_name"
                            android:textColor="@color/national_ink"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.02"
                            android:singleLine="true"
                            android:ellipsize="end" />

                        <LinearLayout
                            android:id="@+id/government_id_dates_row"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:orientation="horizontal"
                            android:gravity="top">

                            <LinearLayout
                                android:id="@+id/government_id_dob_column"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:paddingEnd="8dp">

                                <TextView
                                    android:id="@+id/government_id_dob_label"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/label_date_of_birth"
                                    android:textColor="@color/national_muted"
                                    android:textSize="8sp"
                                    android:textStyle="bold"
                                    android:letterSpacing="0.26"
                                    android:singleLine="true"
                                    android:ellipsize="end" />

                                <TextView
                                    android:id="@+id/government_id_dob"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="@string/empty_value"
                                    android:textColor="@color/national_ink"
                                    android:textSize="10sp"
                                    android:textStyle="bold"
                                    android:letterSpacing="0.04"
                                    android:maxLines="1"
                                    android:ellipsize="end" />

                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/government_id_expiry_column"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/government_id_expiry_label"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/label_expiry_date"
                                    android:textColor="@color/national_muted"
                                    android:textSize="8sp"
                                    android:textStyle="bold"
                                    android:letterSpacing="0.26"
                                    android:singleLine="true"
                                    android:ellipsize="end" />

                                <TextView
                                    android:id="@+id/government_id_expiry"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="@string/empty_value"
                                    android:textColor="@color/national_ink"
                                    android:textSize="10sp"
                                    android:textStyle="bold"
                                    android:letterSpacing="0.04"
                                    android:maxLines="1"
                                    android:ellipsize="end" />

                            </LinearLayout>

                        </LinearLayout>

                        <TextView
                            android:id="@+id/government_id_number_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="@string/preview_number_label"
                            android:textColor="@color/national_muted"
                            android:textSize="8sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.26"
                            android:singleLine="true"
                            android:ellipsize="end" />

                        <TextView
                            android:id="@+id/government_id_number"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/empty_value"
                            android:textColor="@color/national_ink"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:fontFamily="monospace"
                            android:letterSpacing="0.04"
                            android:singleLine="true"
                            android:ellipsize="end" />

                    </LinearLayout>

                </LinearLayout>

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />
            </LinearLayout>

        </FrameLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>
