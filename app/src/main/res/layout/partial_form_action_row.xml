<?xml version="1.0" encoding="utf-8"?>
<!-- Shared form action row (bank card / government ID / social account):
     outline Save + outline-red Delete side by side. Delete starts GONE
     (add mode); edit mode shows it and drops Save's trailing margin in code.
     Included with <include layout="@layout/partial_form_action_row" /> — ids are
     shared, so findViewById(R.id.form_save_button/form_delete_button/form_save_label) works
     unchanged in every form. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="24dp"
    android:orientation="horizontal">

    <LinearLayout
        android:id="@+id/form_save_button"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_weight="1"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_button_outline"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="@string/action_save"
            android:src="@drawable/ic_edit" />

        <TextView
            android:id="@+id/form_save_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="@string/action_save"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/form_delete_button"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_weight="1"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_button_outline_red"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="@string/action_delete"
            android:src="@drawable/ic_delete" />

        <TextView
            android:id="@+id/form_delete_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="@string/action_delete"
            android:textColor="@color/danger"
            android:textSize="14sp" />

    </LinearLayout>

</LinearLayout>
