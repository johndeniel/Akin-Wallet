<?xml version="1.0" encoding="utf-8"?>
<!-- Trash — soft-deletes as one uniform set of selectable tiles
     (centered icon + title + masked hint, paired two-per-row). Tap toggles
     selection; the toolbar turns contextual (count + select-all) and the
     bottom bar offers bulk Restore / Delete forever. M3 empty card
     when empty. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".activity.TrashActivity"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_dashboard_root"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="16dp"
    android:paddingBottom="16dp">

    <!-- Contextual M3 small top app bar: "Trash" idle, "N selected" + close
         while selecting. Same insets as Settings so headers match. -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/trash_toolbar"
        style="@style/Widget.Akin.Toolbar"
        android:layout_width="match_parent"
        app:title="@string/trash_title" />

    <!-- Trash grid: faces span both columns, social cells pair up. -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/trash_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:clipToPadding="false" />

    <!-- Bulk action bar: visible only while items are selected. -->
    <LinearLayout
        android:id="@+id/trash_bulk_action_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/trash_bulk_restore_button"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:minHeight="48dp"
            android:text="@string/trash_restore"
            android:textColor="@color/text_primary"
            app:backgroundTint="@color/dashboard_well"
            app:icon="@drawable/restore"
            app:iconSize="18dp"
            app:iconTint="@color/dashboard_active" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/trash_bulk_delete_button"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:minHeight="48dp"
            android:text="@string/trash_delete_forever"
            android:textColor="@color/danger"
            app:icon="@drawable/ic_delete"
            app:iconSize="18dp"
            app:iconTint="@color/danger"
            app:strokeColor="@color/danger" />

    </LinearLayout>

    <!-- Empty state: M3 filled card with icon well, title + supporting text. -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/trash_empty_state"
        style="@style/Widget.Akin.DashboardCard"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:visibility="gone"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <FrameLayout
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_dashboard_circle">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/trash_title"
                    android:src="@drawable/ic_trash" />

            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="@string/trash_empty_title"
                android:textAppearance="@style/TextAppearance.Akin.CardTitle" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="@string/trash_empty_sub"
                android:textAppearance="@style/TextAppearance.Akin.BodyMuted" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
