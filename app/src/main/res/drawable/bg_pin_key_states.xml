<?xml version="1.0" encoding="utf-8"?>
<!-- PIN key states: glass navy disc, hairline top-light.
     Pressed = royal glow. Wrapped by bg_pin_key ripple. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:startColor="@color/pin_key_pressed_top"
                android:endColor="@color/pin_key_pressed_bottom" />
            <stroke android:width="1dp" android:color="@color/dot_filled_start" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:startColor="@color/pin_key_top"
                android:endColor="@color/pin_key_bottom" />
            <stroke android:width="1dp" android:color="@color/pin_key_stroke" />
        </shape>
    </item>
</selector>
