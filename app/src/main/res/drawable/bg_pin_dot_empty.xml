<?xml version="1.0" encoding="utf-8"?>
<!-- PIN dot, empty: deep well with cool hairline — reads as a slot
     waiting to be filled, not a faint outline. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/dot_empty_fill" />
            <stroke android:width="1.5dp" android:color="@color/dot_empty_stroke" />
            <size android:width="16dp" android:height="16dp" />
        </shape>
    </item>
    <item android:top="2dp" android:left="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="oval">
            <solid android:color="#0A1528" />
            <size android:width="12dp" android:height="12dp" />
        </shape>
    </item>
</layer-list>
