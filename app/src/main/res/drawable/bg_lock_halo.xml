<?xml version="1.0" encoding="utf-8"?>
<!-- Soft halo that sits behind the 3D Akin mark — radial blue glow
     fading to transparent so the logo appears to float. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <gradient
        android:type="radial"
        android:gradientRadius="120dp"
        android:centerX="0.5"
        android:centerY="0.5"
        android:startColor="@color/lock_halo_center"
        android:endColor="@color/lock_halo_edge" />
</shape>
