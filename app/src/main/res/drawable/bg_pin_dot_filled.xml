<?xml version="1.0" encoding="utf-8"?>
<!-- PIN dot, filled: bright blue gradient core + outer glow halo.
     The only saturated accent on the screen, so progress pops. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/dot_filled_glow" />
            <size android:width="20dp" android:height="20dp" />
        </shape>
    </item>
    <item android:top="2dp" android:left="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="oval">
            <gradient
                android:angle="135"
                android:startColor="@color/dot_filled_start"
                android:endColor="@color/dot_filled_end" />
            <size android:width="16dp" android:height="16dp" />
        </shape>
    </item>
    <item android:top="5dp" android:left="5dp" android:right="5dp" android:bottom="5dp">
        <shape android:shape="oval">
            <solid android:color="#B3FFFFFF" />
            <size android:width="10dp" android:height="10dp" />
        </shape>
    </item>
</layer-list>
